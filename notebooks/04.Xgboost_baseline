   "metadata": {},
   "outputs": [],
   "source": [
    "#Feature set\n",
    "features = [\n",
    "    \"txn_count_1h\",\n",
    "    \"txn_count_24h\",\n",
    "    \"txn_count_7d\",\n",
    "    \"avg_amt_1h\",\n",
    "    \"avg_amt_24h\",\n",
    "    \"avg_amt_7d\",\n",
    "    \"max_amt_24h\",\n",
    "    \"amount_zscore_24h\",\n",
    "    \"is_night_txn\",\n",
    "    \"velocity_risk\"\n",
    "]\n",
    "\n",
    "X = df[features]\n",
    "y = df[\"isFraud\"]\n"
   ]
  },
  {
